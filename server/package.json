{
  "name": "pos-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "npx prisma migrate deploy && node server.js",
    "dev": "node --watch server.js",
    "build": "npm install && cd ../client && npm install && npm run build && cd ../server && npx prisma generate",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "db:dump": "pg_dump -U idor -d idor_testbed -F c -f ./snapshots/dataset.dump"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "jimp": "^1.6.1",
    "morgan": "^1.12.1",
    "multer": "^2.1.1",
    "sanitize-html": "^2.17.4",
    "seedrandom": "^3.0.5",
    "prisma": "^6.19.3"
  }
}
